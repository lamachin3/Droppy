# Django Settings
DEBUG=1
SECRET_KEY=django-insecure-dev-key-change-me-in-production
DJANGO_ALLOWED_HOSTS=localhost 127.0.0.1 backend droppy.local

# Database
SQL_ENGINE=django.db.backends.sqlite3
SQL_DATABASE=db.sqlite3
SQL_USER=
SQL_PASSWORD=
SQL_HOST=droppy_db
SQL_PORT=

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://droppy.local
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://droppy.local

# Media files
MEDIA_ROOT=/app/media
STATIC_ROOT=/app/staticfiles
