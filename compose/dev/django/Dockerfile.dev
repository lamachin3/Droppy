FROM archlinux:latest

# Environment setup
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    YARA_RULES_URL="https://github.com/BlackSnufkin/LitterBox/archive/refs/heads/main.zip" \
    YARA_RULES_DIR="/app/api/analysis/services/yara_rules/rules"

WORKDIR /app

# System update and minimal dependencies
RUN pacman -Syu --noconfirm

ADD setup.sh /setup.sh
RUN chmod +x /setup.sh
RUN /setup.sh

COPY backend/requirements.txt .

RUN pacman -S --noconfirm --needed base-devel python python-pip python-zstandard python-wheel
RUN pip install --break-system-packages -r requirements.txt

COPY compose/dev/django/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]